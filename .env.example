# Backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_BACKEND_ROOT_URL=http://localhost:4000
NEXT_PUBLIC_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20

# NextAuth (Auth.js v5)
