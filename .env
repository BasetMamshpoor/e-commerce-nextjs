# Backend API base URL (Express server, no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Backend root URL (for sitemap.xml, robots.txt proxy and /uploads/* paths)
NEXT_PUBLIC_BACKEND_ROOT_URL=http://localhost:4000

# Public site URL (used in metadata, OpenGraph, canonical URLs)
NEXT_PUBLIC_PUBLIC_SITE_URL=http://localhost:3000

# Default page size for product listing
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20
